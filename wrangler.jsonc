{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hk-smart-map",
  "main": "workers/refresh-trains.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "TRAIN_CACHE",
      "bucket_name": "hk-map-trains"
    }
  ]
}
